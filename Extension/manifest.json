{
  "manifest_version": 3,
  "name": "Screen Time Tamagotcha",
  "version": "1.0",
  "description": "Keep your digital pet healthy by staying focused and limiting screen time on distracting sites.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Time Tamagotcha",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "options_page": "options.html",
  "key": "",
  "oauth2": {
    "client_id": "94960480955-aes04iam8ukrv421h0nqknicqsjlka7r.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}